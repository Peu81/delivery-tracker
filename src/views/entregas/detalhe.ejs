<body class="tela-sistema">
    <main class="container" style="max-width: 800px;">
        <div class="cabecalho">
            <h1>Detalhes da entrega #<%= entrega.id %></h1>
            <a href="/painel/entregas" class="btn btn-secundario">Voltar a listagem</a>
        </div>
    
        <div class="lista-entregas">
            <p>Descrição:  <%= entrega.descricao %></p>
            <p>Origem:  <%= entrega.origem %></p>
            <p>Destino:  <%= entrega.destino %></p>
            <p>Status:  <%= entrega.status %></p>
        </div>
    
        <section class="acoes">
            <form action="/painel/entregas/<%= entrega.id %>/avancar" method="POST">
                <input type="hidden" name="_method" value="PATCH">
                <button type="submit" class="btn btn-primario">Avançar status</button> 
            </form>
            <button type="button" class="btn btn-perigo" onclick="cancelarEntrega('<%= entrega.id %>')">Cancelar entrega </button>
            
            <form action="/painel/entregas/<%= entrega.id %>/atribuiMotorista" method="POST">
                <input type="hidden" name="_method" value="PATCH">
                <select name="motoristaId" required>
                    <option value="" disabled selected>Escolha um motorista</option>
                    <% if (typeof motoristas !== 'undefined') { %>
                        <% motoristas.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.nome %></option>
                        <% }) %>
                    <% } %>
                </select>
    
                <button type="submit" class="btn btn-secundario">Atribuir motorista</button> 
            </form>
    
        </section>
    
        <section class="historico">
            <h2>Histórico de eventos</h2>
            <% if (typeof historico !== 'undefined' && historico.length > 0) { %>
                <ul>
                    <% historico.forEach(h => { %>
                        <li>
                            <strong><%= new Date(h.createdAt).toLocaleDateString('pt-BR') %> às <%= new Date(h.createdAt).toLocaleTimeString('pt-BR') %>:</strong>
                            <%= h.informacoes %>
                        </li>
                    <% }) %>    
                </ul>
            <% } else { %>
                <p>Não há eventos registrados para esta entrega.</p>
            <% } %>
        </section>
    </main>
</body>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
    async function cancelarEntrega(entregaId) {
        const token = localStorage.getItem('accessToken'); 
    
        if (!token) {
            alert('Você não está autenticado. Por favor, realize o login.');
            window.location.href = '/painel/login';
            return;
        }
    
        if (!confirm('Tem certeza que deseja cancelar esta entrega?')) {
            return;
        }
        try {
            await axios.patch(`/api/entregas/${entregaId}/cancelar`, {}, {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });
    
            alert('Entrega cancelada com sucesso!');
            window.location.reload();
            
        } catch (erro) {
            if (erro.response) {
                const status = erro.response.status;
                if (status === 403) {
                    alert('Acesso Negado: Apenas GESTORES podem cancelar entregas.');
                } else if (status === 401) {
                    alert('Sessão expirada. Faça login novamente.');
                    window.location.href = '/painel/login';
                } else {
                    alert(`Erro: Falha ao cancelar a entrega.`);
                }
            } else {
                alert('Erro de conexão com o servidor.');
            }
        }
    }
    </script>

<script>
    if (!localStorage.getItem('accessToken')) {
        window.location.href = '/painel/login';
    }
</script>
<body class="tela-registro">
  <main>
    <div class="formulario">
      <h1 class="titulo">CADASTRO</h1>
      <form id="form-registro">
          <div class="form-group">
            <label for="nome">Nome:</label>
            <input
              type="text"
              id="nome"
              name="nome"
              value="<%= typeof usuario !== 'undefined' && usuario.nome ? usuario.nome : '' %>"
              placeholder="Nome completo"
              required
          >
          </div>
          <div class="form-group">
            <label for="login">Email:</label>
            <input
              type="text"
              id="email"
              name="email"
              value="<%= typeof usuario !== 'undefined' && usuario.email ? usuario.email : '' %>"
              placeholder="Email do usuário"
              required
          >
          </div>

          <div class="form-group">
            <label for="senha">Senha:</label>
              <input
                type="password"
                id="senha"
                name="senha"
                value="<%= typeof usuario !== 'undefined' && usuario.senha ? usuario.senha : '' %>"
                placeholder="Senha"
                required
              >
            </div>
            <div class="form-acoes">
              <button type="submit" class="btn btn-primario">Cadastrar usuário</button>
            </div>
      </form>      
    </div>
  </main>
</body>

<script>
  document.getElementById('form-registro').addEventListener('submit', async function(event) {
    event.preventDefault();

    const nome = document.getElementById('nome').value;
    const email = document.getElementById('email').value;
    const senha = document.getElementById('senha').value;

    try {
    const resposta = await axios.post('/api/auth/registrar', {nome, email, senha});

    setTimeout(() => {window.location.href='/painel/login'}, 2000);
  } catch (error) {
    if (error.response && error.response.status === 409) {
      alert("Erro: Este e-mail já está cadastrado!");
    } else {
      alert("Erro ao tentar cadastrar o usuário. Tente novamente.");
    }
  }
  });
</script>

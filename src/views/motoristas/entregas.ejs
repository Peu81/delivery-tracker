<body class="tela-sistema">
    <main class="container">
        <div class="cabecalho">
            <h1>Entregas atribuídas a <%= motorista.nome %></h1>
            <a href="/painel/motoristas" class="btn btn-secundario">Voltar</a>
        </div>
    
        <% if (entregas.length === 0) { %>
        <p class="vazio">Não há entregas atribuídas a esse motorista.</p>
        <% } else { %>
            <table class="tabela">
                <thead>
                    <tr><th>ID</th><th>Descrição</th><th>Origem</th><th>Destino</th><th>Status</th></tr>
                </thead>
    
                <tbody>
                    <% entregas.forEach(e => { %>
                        <tr>
                            <td><%= e.id %></td>
                            <td><%= e.descricao %></td>
                            <td><%= e.origem %></td>
                            <td><%= e.destino %></td>
                            <td><span class="badge badge-<%= e.status.toLowerCase() %>"><%= e.status %></span></td>
                            <td>
                                <a class="btn btn-primario btn-pequeno" href="/painel/entregas/<%= e.id %>">
                                    Ver Detalhes.
                                </a>
                            </td>                    
                        </tr>
                   <% }); %>
                </tbody>
            </table>
        <% } %>
    </main>
</body>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
    if (!localStorage.getItem('accessToken')) {
        window.location.href = '/painel/login';
    }
</script>
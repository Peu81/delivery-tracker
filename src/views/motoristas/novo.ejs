<body class="tela-login">
  <div class="formulario">
    <% if (typeof erro !== 'undefined' && erro){ %> 
      <div class="erros"> <%= erro %> </div>
    <% } %>
    <h1 class="titulo">Novo Motorista</h1>
    <form method="POST" action="/painel/motoristas">
      <div class="form-group">
        <label for="nome">Nome</label>
        <input
          type="text"
          id="nome"
          name="nome"
          value="<%= typeof motorista !== 'undefined' && motorista.nome ? motorista.nome : '' %>"
          placeholder="Nome completo"
          required
        >
      </div>

      <div class="form-group">
        <label for="cpf">CPF</label>
        <input
          type="text"
          id="cpf"
          name="cpf"
          value="<%= typeof motorista !== 'undefined' && motorista.cpf ? motorista.cpf : '' %>"
          placeholder="Digite apenas números"
          required
        >
      </div>

      <div class="form-group">
        <label for="placa">Placa do veículo</label>
        <input
          type="text"
          id="placaVeiculo"
          name="placaVeiculo"
          value="<%= typeof motorista !== 'undefined' && motorista.placaVeiculo ? motorista.placaVeiculo : '' %>"
          placeholder="Exemplo: AAAA-111"
          required
        >
      </div>

      <div class="form-acoes">
        <button type="submit" class="btn btn-primario">Criar Motorista</button>
        <a href="/painel" class="btn btn-secundario">Voltar ao menu principal</a>      
      </div>
    </form>
  </div>
</body>

<script>
  const token = localStorage.getItem('accessToken');

  if (!token) {
      window.location.href = '/painel/login';
  } else {
      try {
          const payload = JSON.parse(atob(token.split('.')[1]));

          if (payload.papel === 'OPERADOR') {
              alert('Acesso Negado: Apenas GESTORES podem cadastrar motoristas.');
              window.location.href = '/painel';
          }
      } catch (error) {
          console.error('Erro ao decodificar token', error);
          localStorage.removeItem('accessToken');
          window.location.href = '/painel/login';
      }
  }
</script>